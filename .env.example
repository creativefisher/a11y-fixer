# Skip login/signup (local dev / preview only)
AUTH_DISABLED=true

# Local PGlite (default if unset). Production needs a hosted Postgres URL.
DATABASE_URL=pglite:./data/pglite

# Force heuristic fix proposals (no LLM). Useful for tests and offline demos.
# Leave unset in production once Builder.io is connected for agent-generated fixes.
A11Y_MOCK_LLM=true

# Custom health check message
PING_MESSAGE=pong

# Standalone production needs a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred.
# BETTER_AUTH_SECRET=

# Allow auditing http://127.0.0.1 (local fixture demos only)
# A11Y_ALLOW_LOCAL_FETCH=true

# Identity for `pnpm action` CLI (local only)
AGENT_USER_EMAIL=dev@local.test
